rules_version = '2';

// Aturan keamanan Kas Aceh Mandiri Utama (v2.2).
// Email owner di isOwner() harus sama dengan OWNER_EMAIL di firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.token.email == 'cashflow.amu@gmail.com';
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Kasir aktif dari cabang aktif `bid`
    function isStaffOf(bid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == 'cabang'
        && profile().active == true
        && profile().branchId == bid
        && get(/databases/$(database)/documents/branches/$(bid)).data.active != false;
    }

    // Daftar kategori yang ditetapkan owner, per jenis ('in' / 'out')
    function catList(t) {
      return get(/databases/$(database)/documents/settings/categories).data[t];
    }

    function validTx(d) {
      return d.keys().hasAll(['branchId', 'type', 'amount', 'date', 'no', 'desc', 'category', 'createdBy', 'createdAt'])
        && d.type in ['in', 'out']
        && d.amount is number && d.amount > 0 && d.amount < 100000000000000
        && d.date is string && d.date.size() == 10
        && d.desc is string && d.desc.size() > 0 && d.desc.size() <= 500
        && d.category is string && d.category in catList(d.type)
        && d.createdBy == request.auth.uid;
    }

    // Edit owner: bentuk data tetap sah, pencatat asli tidak boleh berubah
    function validEdit(d) {
      return d.keys().hasAll(['branchId', 'type', 'amount', 'date', 'no', 'desc', 'category', 'createdBy', 'createdAt'])
        && d.type in ['in', 'out']
        && d.amount is number && d.amount > 0 && d.amount < 100000000000000
        && d.date is string && d.date.size() == 10
        && d.desc is string && d.desc.size() > 0 && d.desc.size() <= 500
        && d.category is string
        && d.createdBy == resource.data.createdBy
        && d.createdAt == resource.data.createdAt;
    }

    // Login kasir: dibuat dan diubah hanya oleh owner; kasir hanya membaca profilnya sendiri
    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // Cabang: hanya owner yang menambah, mengubah, menghapus
    match /branches/{bid} {
      allow read: if isOwner() || isStaffOf(bid);
      allow write: if isOwner();
    }

    // Transaksi: kasir hanya membaca dan menambah di cabangnya sendiri; hanya owner yang mengubah/menghapus
    match /tx/{tid} {
      allow read: if isOwner() || isStaffOf(resource.data.branchId);
      allow create: if (isOwner() || isStaffOf(request.resource.data.branchId)) && validTx(request.resource.data);
      // Edit & hapus hanya owner, termasuk transaksi yang dicatat kasir
      allow update: if isOwner() && validEdit(request.resource.data);
      allow delete: if isOwner();
    }

    // Pengaturan: 'app' (logo) terbuka untuk halaman masuk; 'categories' untuk pengguna yang sudah masuk.
    // Hanya owner yang mengubah.
    match /settings/{sid} {
      allow read: if sid == 'app' || signedIn();
      allow write: if isOwner() && sid in ['app', 'categories'];
    }

    // Log aktivitas: pengguna terdaftar menulis catatannya sendiri; hanya owner yang membaca.
    // Tidak bisa diubah atau dihapus dari aplikasi.
    match /logs/{lid} {
      allow read: if isOwner();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at is number
        && request.resource.data.action is string && request.resource.data.action.size() <= 60
        && (isOwner() || exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
